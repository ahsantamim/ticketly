# Local development config, read by config/settings/dev.py.
# Copy to .env and fill in real values: cp .env.example .env
# Never commit .env.

# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string

# Comma-separated hostnames this site may serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database connection URL. Leave commented to use SQLite at <repo>/db.sqlite3.
# DATABASE_URL=postgres://user:password@localhost:5432/ticketly
